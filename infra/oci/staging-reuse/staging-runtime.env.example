# FR Finance — inert sample, DO NOT USE AS DEPLOYMENT APPROVAL.
# Never place passwords, keys, tokens, DB DSNs or real user identities here.
# Runtime secrets must be fetched from OCI Vault after authorized IAM review.
# This does NOT replace actual API-level authorization and financial gates.
ENVIRONMENT=homologation
OCI_REGION=sa-saopaulo-1
FR_FINANCE_PIX_REAL=0
FR_FINANCE_REAL_USER_ACTIVATION=0
FRC_MP_OCI_STAGING_ENABLED=0
FRC_MP_ACCEPT_LIVE_NOTIFICATIONS=0
FR_FINANCE_REAL_MAIL=0
