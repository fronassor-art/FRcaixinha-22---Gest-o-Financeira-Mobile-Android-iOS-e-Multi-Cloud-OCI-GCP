-- M40040: a committed synthetic receipt whose response to the caller may be lost.
-- NEVER execute outside the disposable GitHub PostgreSQL18 CI service.
\set ON_ERROR_STOP on
\ir m40030_disposable_guard.psql
\if :{?CI_M40040_DISPOSABLE}
\else
\echo M40040_BLOCKED_MISSING_CI_FLAG
\quit 2
\endif
SELECT CASE WHEN current_database()='frcaixinha_ci'
 AND inet_server_port()=5432
 AND session_user='postgres'
 AND current_setting('frfinance.m40040_ci',true)='DISPOSABLE_ONLY'
 THEN 'true' ELSE 'false' END AS m40040_disposable_identity
\gset
\if :m40040_disposable_identity
\else
\echo M40040_BLOCKED_WRONG_CLUSTER
\quit 2
\endif
