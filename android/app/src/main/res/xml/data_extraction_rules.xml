<?xml version="1.0" encoding="utf-8"?>
<!-- FR Finance: Android 12+ cloud backup AND device-to-device transfer.
     Personal sessions, financial data and local webview state are never
     eligible for automatic transfer. Android/OEM behavior is not proof
     of runtime non-extraction; validate the merged release manifest. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
